# Copy this file to ".env" (same folder) and fill in the key(s) you have.
# You only need ONE of these. Keys typed in the web page override these values.
# Never commit your real .env file.

# Google Gemini  - https://aistudio.google.com/apikey  (free tier)
GEMINI_API_KEY=

# Groq           - https://console.groq.com/keys       (free tier; also used for Whisper fallback)
GROQ_API_KEY=

# xAI Grok       - https://console.x.ai
XAI_API_KEY=

# Hugging Face   - https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: full path to ffmpeg.exe if it is not on PATH (only used to transcribe videos without captions)
# FFMPEG_PATH=

# NVIDIA NIM     - https://build.nvidia.com
NVIDIA_API_KEY=

# Local llama-server (no key needed on this machine). For a remote GPU server use an https URL
# and its key. Defaults to http://127.0.0.1:8081/v1.
# LNAI_LOCAL_URL=
# LNAI_LOCAL_KEY=

# Deprecated "colab" provider: prefer LNAI_LOCAL_URL + LNAI_LOCAL_KEY. Still read for one release.
COLAB_LLM_URL=
COLAB_LLM_KEY=
