# Files kept out of the Docker build context (the API image builds from the repo root).
# Secrets, dependencies, runtime data and caches never enter an image.

# Secrets
**/.env

# Dependencies and virtual environments (installed inside the image)
**/node_modules
**/.venv
apps/api/.npmrc

# Runtime data, caches and generated output
.data
.run
**/.npm-cache
.pip-cache
apps/api/data
apps/worker/backend/output
apps/worker/backend/.cache
apps/worker/backend/.tmp
**/output

# Local tools, model weights and large files the images do not need
.git
.tools
**/.tools
models
docs/*.pdf
apps/web/screenshots
