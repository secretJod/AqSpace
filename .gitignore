# Git ignore rules for the whole repository.
# Everything the app creates at runtime lives in one of the paths below, and
# scripts/nuke.sh removes all of it.

# Environment files and secrets (only the .example templates are committed)
.env
.env.*
!.env.example

# Dependencies and build output
node_modules/
dist/
*.egg-info/

# Python caches and virtual environments
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# Logs
*.log

# Editor and OS files
.vscode/
.DS_Store

# Runtime data, caches and scratch space (see scripts/nuke.sh)
.data/
.run/
.npm-cache/
.pip-cache/
**/.cache/
**/.tmp/
**/output/
*.db
apps/api/data/
apps/worker/backend/output/
apps/worker/backend/.env

# Repo-local tool binaries and their login state
.tools/
.gh-config/

# Local model weights (several GB)
models/

# Browser automation output (screenshots, snapshots, downloads)
.playwright-mcp/

# Local-only helper scripts for the project board
/scripts/gh.sh
/scripts/board.sh

# Local working notes (kept on the development machine only)
/.claude/
/docs/PLAN.md
/docs/AGENT_JOURNAL.md
/docs/team-architecture-notes.md
/docs/daily/
/docs/qa/
/docs/client/
/docs/decisions/
/docs/deploy/
/docs/upstream/
/docs/dev-notebook.json
/docs/AQ-Learning-Dev-Notebook.pdf
