# Settings for the API service (aq-api), read by docker compose.
#
# Copy this file to .env in the repository root and fill it in. docker compose
# reads .env automatically. Never commit .env: it holds real secrets.
#
# AI provider keys do not go here. They belong in apps/worker/backend/.env
# (copy apps/worker/backend/.env.example).

# ---------------------------------------------------------------------------
# Sign-in
# ---------------------------------------------------------------------------

# local  = a single local user, no sign-in (the default)
# google = sign in with a Google account (needs the four settings below)
AUTH_MODE=local

# OAuth client from Google Cloud Console > APIs & Services > Credentials
# (application type: Web application).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Where Google sends the user back after sign-in. Register this exact value
# under "Authorized redirect URIs" in Google Cloud Console:
#   http://localhost:5180/api/v1/auth/google/callback
# A Cloudflare quick tunnel URL (*.trycloudflare.com) changes on every restart,
# so sign-in through a tunnel needs a fixed hostname (a named tunnel). Register
#   https://<your-fixed-host>/api/v1/auth/google/callback
# and use that value here.
GOOGLE_REDIRECT_URI=http://localhost:5180/api/v1/auth/google/callback

# Signs session cookies. Use at least 32 random characters, for example:
#   openssl rand -hex 32
SESSION_SECRET=change-me-run-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Provider for "Smart arrange". Its key goes in apps/worker/backend/.env.
# PY_SMART_PROVIDER=gemini

# Developer tracker at /dev. 1 = on (default), 0 = off.
# It is never served to requests that arrive through the tunnel.
# AQ_DEV_TOOLS=1
