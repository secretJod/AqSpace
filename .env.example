# Copy to .env and fill in
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Goes through the Vite proxy (5173) so the session cookie is same-origin
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
SESSION_SECRET=change-me-to-a-long-random-string

# Optional, read by docker compose for aq-api (shell or this .env):
# PY_SMART_PROVIDER=gemini   # provider for "Smart arrange"; its key goes in lecture-notes-ai/backend/.env
# AQ_DEV_TOOLS=1             # /dev tracker; 0 = off (never served through the tunnel)
