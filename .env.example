# Copy to .env and fill in
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Goes through the Vite proxy (5173) so the session cookie is same-origin
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
SESSION_SECRET=change-me-to-a-long-random-string
# aq-api: AUTH_MODE=local (default, single user) or google.
# For aq-api in google mode set GOOGLE_REDIRECT_URI=http://localhost:5180/api/v1/auth/google/callback (or the tunnel URL).
AUTH_MODE=local
