# Copy to .env (root of the repo) and fill in. docker compose reads it automatically.
# .env is ignored by version control: never commit real keys.

# --- Sign-in (aq-api) ---
# AUTH_MODE: local = single local user, no sign-in (default). google = Google sign-in.
AUTH_MODE=local

# OAuth client from Google Cloud Console > APIs & Services > Credentials (type: Web application).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Where Google sends the user back. Register this EXACT value under
# "Authorized redirect URIs" in Google Cloud Console:
#   http://localhost:5180/api/v1/auth/google/callback
# A Cloudflare quick tunnel URL (*.trycloudflare.com) changes on every restart, so
# sign-in through the tunnel needs a fixed hostname (named tunnel); then register
#   https://<your-fixed-host>/api/v1/auth/google/callback  and use it here.
GOOGLE_REDIRECT_URI=http://localhost:5180/api/v1/auth/google/callback

# Signs session cookies. Must be 32+ random characters. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=change-me-run-openssl-rand-hex-32

# --- Optional, read by docker compose for aq-api ---
# PY_SMART_PROVIDER=gemini   # provider for "Smart arrange"; its key goes in lecture-notes-ai/backend/.env
# AQ_DEV_TOOLS=1             # /dev tracker; 0 = off (never served through the tunnel)
